{
  "name": "dsh-sapi-budget",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Sync AiSpot (sapi) group pricing and show per-turn and per-session cost.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "pricing.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "name": "sapi-budget",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lanstzz/sapi-budget.git"
  },
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "pricing",
    "cost",
    "aispot",
    "sapi"
  ]
}
